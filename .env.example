DARKVI_API_TOKEN=
APP_URL=http://localhost:3000

# Chaves dos LLMs de roteiro (fallback do servidor; o usuário também pode
# informar a chave nas Configurações, que tem prioridade). Opcionais.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Execute `npm run auth:setup` para gerar valores seguros.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Neon Postgres (Prisma). DATABASE_URL = conexao pooled (runtime, com
# pgbouncer=true); DIRECT_URL = conexao direta/unpooled (migracoes).
DATABASE_URL=
DIRECT_URL=

# Chave AES-256-GCM em base64 (32 bytes) para criptografar as chaves de API
# guardadas no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
