APP_URL=http://localhost:3000

# Chaves compartilhadas do servidor. Cada usuário informa a PRÓPRIA chave em
# Configurações (guardada criptografada por usuário no banco). Estas variáveis
# servem apenas de fallback para o ADMIN — usuários comuns são obrigados a usar
# a própria chave. Todas opcionais.
DARKVI_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Execute `npm run auth:setup` para gerar valores seguros.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Neon Postgres (Prisma). DATABASE_URL = conexao pooled (runtime, com
# pgbouncer=true); DIRECT_URL = conexao direta/unpooled (migracoes).
DATABASE_URL=
DIRECT_URL=

# Chave AES-256-GCM em base64 (32 bytes) para criptografar as chaves de API
# guardadas no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Estúdio de produção documental (todos os segredos ficam no servidor).
PEXELS_API_KEY=
MEDIA_STORAGE_DIR=./storage/media
VOICESTUDIO_BASE_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_MODEL=tts-1
# Catálogo de música/efeitos do workspace não encontrado. Use arquivos próprios/licenciados.
# Supabase não configurado: se o catálogo existente estiver em outro workspace, integre um adapter antes de definir estas chaves.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
