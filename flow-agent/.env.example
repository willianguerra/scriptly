# O Agent aceita somente endereços de loopback.
FLOW_AGENT_HOST=127.0.0.1
FLOW_AGENT_PORT=8765

# Origens explícitas, separadas por vírgula. Wildcard (*) não é aceito.
FLOW_AGENT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

FLOW_AGENT_LOG_LEVEL=INFO

# Opcional. No Windows, o padrão é %LOCALAPPDATA%\ScriptlyFlowAgent.
# Mantenha este diretório fora do código-fonte.
# FLOW_AGENT_DATA_DIR=C:\Users\seu-usuario\AppData\Local\ScriptlyFlowAgent

FLOW_AGENT_BROWSER_PROFILE=video
FLOW_AGENT_BROWSER_HEADLESS=false
FLOW_AGENT_FLOW_URL=https://labs.google/fx/tools/flow
FLOW_AGENT_NAVIGATION_TIMEOUT_MS=60000
